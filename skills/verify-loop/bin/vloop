#!/usr/bin/env python3
"""agent-verify-loop CLI. See ../SKILL.md."""
import os
import sys
from pathlib import Path

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))

from vlooplib import paths  # noqa: E402
from vlooplib.cli import main  # noqa: E402

# Keep the path the CLI was invoked by (skills.sh symlinks the installed copy) so printed paths match the agent's
# permission rules.
paths.SKILL_DIR = Path(os.path.abspath(__file__)).parent.parent

sys.exit(main())
