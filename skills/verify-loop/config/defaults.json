{
  "schema": 1,
  "mode": "warn",
  "transport": "auto",
  "transport_modules": [],
  "platforms": {"codex": {"triage": {"model": null, "effort": "medium"},
                         "models": {"reviewer": null, "qa": null, "security": null, "perf": null, "ux": null}}},
  "gate": {"max_blocks_per_fp": 2, "inflight_ttl_min": 60, "non_cli_mode": "warn",
           "scan_on_stop": {"claude": false, "codex": true}},
  "integrity": {"enabled": true, "qa_allowed_paths": []},
  "loop": {"max_failed_attempts": 3, "max_inconclusive_streak": 2},
  "prefilter": {"trivial_max_lines": 6, "trivial_max_files": 2},
  "material_delta": {"min_lines": 80, "ratio": 0.5},
  "docs_globs": ["*.md", "*.mdx", "*.txt", "*.rst", "*.adoc", "docs/**", "LICENSE*", "CHANGELOG*"],
  "ui_globs": ["*.html", "*.css", "*.scss", "*.sass", "*.less", "*.tsx", "*.jsx", "*.vue", "*.svelte",
               "*.component.ts", "*.page.ts", "*.hbs", "*.ejs", "templates/**", "public/**", "assets/**"],
  "risky_globs": ["**/auth/**", "**/*auth*", "**/security/**", "**/payment*/**", "**/migrations/**", "*.sql",
                  "Dockerfile*", ".github/**", "buildspec*.yml", "**/infra/**", "*.tf", "**/package.json"],
  "security_globs": ["*auth*", "**/*auth*/**", "*session*", "**/*session*/**", "*token*", "*crypto*",
                     "**/*crypto*/**", "*permission*", "**/*permission*/**", "*middleware*", "**/*middleware*/**",
                     "*payment*", "**/*payment*/**", ".github/workflows/**", "*.sql"],
  "config_globs": ["package.json", "**/package.json", "tsconfig*.json", "**/tsconfig*.json", "*.config.*",
                   "**/*.config.*", "project.json", "**/project.json", "nx.json", "angular.json", ".env*",
                   "Dockerfile*", "docker-compose*.yml", "buildspec*.yml", ".github/**", "pyproject.toml",
                   "requirements*.txt"],
  "test_globs": ["*.spec.*", "*.test.*", "**/__tests__/**", "test/**", "tests/**", "**/test/**", "**/tests/**",
                 "e2e/**", "**/e2e/**", "*_test.py", "test_*.py", "cypress/**"],
  "ignore_globs": ["**/package-lock.json", "**/yarn.lock", "**/pnpm-lock.yaml", "**/*.snap", "**/dist/**",
                   "**/*.map", "**/*.min.js"],
  "triage": {"model": "sonnet", "effort": "medium", "timeout_s": 300, "max_budget_usd": 0.60,
             "diff_excerpt_max_lines": 900, "diff_excerpt_max_chars": 60000, "claude_bin": "claude",
             "calibration_runs": 30},
  "specialists": {"security": "auto", "perf": "auto", "ux": "auto"},
  "models": {
    "reviewer": {"standard": ["sonnet", "medium"], "standard_small": ["sonnet", "low"], "deep": ["opus", "medium"],
                 "trivial": ["sonnet", "low"], "delta": ["sonnet", "low"]},
    "security": {"standard": ["sonnet", "high"], "high_risk": ["opus", "medium"], "delta": ["sonnet", "low"]},
    "perf": {"standard": ["sonnet", "medium"], "delta": ["sonnet", "low"]},
    "ux": {"standard": ["sonnet", "medium"], "delta": ["sonnet", "low"]},
    "qa": {"checks": ["haiku", "medium"], "run": ["sonnet", "medium"], "browser": ["sonnet", "medium"],
           "delta_checks": ["haiku", "low"], "delta_run": ["sonnet", "low"], "delta_browser": ["sonnet", "low"]},
    "retro": ["sonnet", "medium"]
  },
  "timeouts_s": {"reviewer": 1200, "security": 1200, "perf": 900, "ux": 900, "qa": 1800, "retro": 1200},
  "permission_mode": "auto",
  "qa_mcp_transport": "mcp-config",
  "agent_transport_browser": true,
  "qa_browser_consent": "ask",
  "retro_policy": {"full_if_main_tokens_over": 400000, "full_if_minutes_over": 45},
  "cost_source": "auto",
  "playwright": {"browser": "chrome", "headless": true, "isolated": true, "viewport": "1366x900",
                 "caps": "devtools,testing", "console_level": "warning", "image_responses": "omit",
                 "file_paths": "absolute"},
  "auth": {"max_age_days": 25},
  "lessons_limit": 5,
  "gc_days": 14
}
